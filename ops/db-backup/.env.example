# Copy thành `.env` (đã gitignore) rồi điền.

# Bot tạo qua @BotFather. Chat id: nhắn bot một tin rồi mở
# https://api.telegram.org/bot<TOKEN>/getUpdates, lấy message.chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Host trong ~/.ssh/config. Key phải không có passphrase hoặc nằm trong
# Keychain, vì launchd chạy không có terminal để hỏi.
SSH_HOST=keemori
COMPOSE_PROJECT=sukien-keemori

# Nằm ngoài repo: bản dump chứa dữ liệu cá nhân của khách.
BACKUP_DIR=$HOME/Backups/sukien-keemori/db
BACKUP_KEEP=2

# Giờ chạy hằng ngày (giờ máy). Đổi thì chạy lại install.sh.
BACKUP_HOUR=22
BACKUP_MINUTE=0
