# Env production của stack sukien.keemori.com, đặt ở /opt/sukien-keemori/.env
# trên VPS (cạnh docker-compose.yml). Compose đọc file này cho `${...}` và nạp
# nguyên file vào backend + migrate (`env_file`).
#
#   cp .env.docker.example .env
#
# KHÔNG commit `.env`. KHÔNG chép `.env` của keemori sang: secret JWT, database
# và webhook phải là bộ riêng — dùng chung JWT secret là token đăng nhập của
# site này qua được guard của site kia.

# ===== Image =====
# Repo Docker Hub RIÊNG. Trùng repo với keemori (alexcoder257/thiep-cuoi-online)
# là `docker compose push` đè tag đang chạy production của keemori.
IMAGE_REPO=alexcoder257/sukien-keemori
BACKEND_IMAGE_TAG=backend
FRONTEND_IMAGE_TAG=frontend
DASHBOARD_IMAGE_TAG=dashboard

# ===== Cổng trên host =====
# keemori đang giữ 3000/3001/3002 và keemori-tools giữ 3100 trên cùng VPS. Chỉ bind 127.0.0.1, nginx
# proxy vào (ops/nginx/sukien-keemori.conf).
HOST_PORT_WEB=3110
HOST_PORT_API=3111
HOST_PORT_CMS=3112

# ===== URL công khai =====
# Không có `/` cuối. Ba giá trị đầu là build arg của frontend/dashboard — đổi
# thì phải build lại image, restart không có tác dụng.
PUBLIC_WEB_URL=https://sukien.keemori.com
PUBLIC_API_URL=https://api-sukien.keemori.com
PUBLIC_CMS_URL=https://cms-sukien.keemori.com
# Để trống khi STORAGE_DRIVER=local. Khi dùng R2: custom domain của bucket
# RIÊNG cho sukien (xem ops/r2/README.md).
UPLOADS_ORIGIN=

# ===== Build arg frontend =====
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# Property GA riêng cho sukien, đừng dùng chung mã với keemori.com.
NEXT_PUBLIC_GA_ID=

# ===== Database (Postgres trong compose) =====
# Container postgres tạo user/database này ở lần khởi động đầu (volume trống).
# DB_HOST/DB_PORT bị compose ghi đè thành `postgres:5432`.
DB_USERNAME=sukien
DB_PASSWORD=
DB_DATABASE=sukien_keemori
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ===== JWT =====
# Dùng chuỗi ngẫu nhiên đủ dài ở môi trường thật.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

# ===== Email (Resend SMTP) =====
# MAIL_USER = luôn là chuỗi literal "resend" (không phải email)
# MAIL_PASSWORD = Resend API key (resend.com/api-keys), dạng re_xxxxxxxx
# Chưa verify domain riêng thì chỉ gửi được TỪ onboarding@resend.dev và ĐẾN
# đúng email đã đăng ký tài khoản Resend — đủ dùng để test trên localhost.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USER=resend
MAIL_PASSWORD=
# Chỉ địa chỉ gửi có tác dụng; tên hiển thị cố định trong code
# (`MAIL_SENDER_NAME`: "Keemori - Thiệp Cưới Online").
MAIL_FROM=onboarding@resend.dev

# Webhook Resend → Telegram: báo khi có thư gửi tới @keemori.com (chỉ người gửi
# + địa chỉ nhận) và khi thư đi bị bounce/spam/failed/chậm. Resend → Webhooks →
# Add endpoint `POST {API_URL}/resend/webhook`, chọn sự kiện email.received,
# email.bounced, email.complained, email.failed, email.delivery_delayed rồi chép
# Signing secret (dạng whsec_...) vào đây. Bỏ trống → webhook trả 503.
RESEND_WEBHOOK_SECRET=

# Tài khoản KHÁCH làm chủ các thiệp trưng bày ở trang chủ, do `npm run seed`
# tạo. KHÔNG phải tài khoản quản trị — tài khoản CMS nằm ở bảng `admin_users`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Google OAuth (đăng nhập bằng Google) =====
# Lấy ở https://console.cloud.google.com/apis/credentials → OAuth client ID,
# loại "Web application". GOOGLE_CALLBACK_URL phải khai y hệt trong mục
# "Authorized redirect URIs", kể cả cổng và dấu `/` cuối.
# Bỏ trống → nút "Tiếp tục với Google" trả lỗi 503 (chưa cấu hình).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api-sukien.keemori.com/auth/google/callback

# ===== Facebook Login (đăng nhập bằng Facebook) =====
# Lấy ở https://developers.facebook.com/apps → app của bạn → Facebook Login →
# Settings. FACEBOOK_CALLBACK_URL phải khai y hệt trong "Valid OAuth Redirect
# URIs". App phải xin quyền `email`; tài khoản Facebook không có email thì
# không đăng nhập được (backend trả lỗi `email_missing`).
# Bỏ trống → nút "Tiếp tục với Facebook" đưa về trang đăng nhập kèm thông báo
# chưa cấu hình.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api-sukien.keemori.com/auth/facebook/callback

# ===== Google Places (gợi ý địa điểm trong editor) =====
# Lấy ở https://console.cloud.google.com/apis/credentials, bật "Places API (New)".
# Key này CHỈ nằm ở backend, không bao giờ gửi ra trình duyệt — key trình duyệt
# chỉ giới hạn được theo HTTP referrer mà header đó giả được.
# Nên đặt thêm quota theo ngày trong Cloud Console: đó là chốt chặn cuối nếu
# mọi lớp chống lạm dụng trong code bị thủng.
# **Tuỳ chọn.** Bỏ trống → gợi ý chạy bằng Photon (OpenStreetMap): miễn phí,
# không cần key, đủ tốt cho đường sá và phường xã Việt Nam. Điền key Google chỉ
# khi cần phủ tên nhà hàng/trung tâm tiệc cưới tốt hơn, và chấp nhận trả tiền
# theo lượt.
GOOGLE_PLACES_API_KEY=

# ===== Google reCAPTCHA v2 (checkbox "Tôi không phải robot") =====
# Lấy ở https://www.google.com/recaptcha/admin (loại reCAPTCHA v2 Checkbox).
# Bỏ trống → bỏ qua kiểm tra captcha (dev).
RECAPTCHA_SECRET_KEY=

# ===== Rate limit =====
# false → tắt toàn bộ rate limit. Chỉ dùng khi dev.
RATE_LIMIT_ENABLED=true

# ===== Lưu trữ ảnh =====
# `local` (mặc định) lưu xuống đĩa của chính server; `r2` đẩy lên Cloudflare R2.
# Dev để trống là chạy được ngay, không cần tài khoản Cloudflare.
STORAGE_DRIVER=local

# --- STORAGE_DRIVER=local ---
# Thư mục trên đĩa và prefix URL công khai tương ứng (xem `LocalDiskProvider`).
# Deploy dạng container phải trỏ UPLOAD_DIR vào volume gắn ngoài, nếu không ảnh
# khách tải lên sẽ mất sau mỗi lần deploy.
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads

# --- STORAGE_DRIVER=r2 ---
# Lấy ở Cloudflare Dashboard > R2. Năm biến dưới đây BẮT BUỘC khi chọn `r2`;
# thiếu một biến là backend sập ngay lúc khởi động (cố ý — hỏng lúc deploy vẫn
# hơn hỏng lúc khách đang tải ảnh lên).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket tạm RIÊNG TƯ cho ảnh editor vừa chọn (kể cả của khách chưa đăng nhập):
# không custom domain, không public access, lifecycle tự xoá sau 1 ngày, CORS
# cho PUT từ trình duyệt. Bắt buộc khi chọn `r2`. Xem ops/r2/README.md.
R2_STAGING_BUCKET=

# --- Vùng tạm khi STORAGE_DRIVER=local ---
# Nằm NGOÀI UPLOAD_DIR: thư mục kia được serve công khai, còn ảnh ở đây chưa
# được kiểm.
UPLOAD_STAGING_DIR=uploads-staging

# ===== Worker nén ảnh =====
# Backend tự sinh một process con nén ảnh (xem ImageWorkerHost). `off` tắt nó —
# chỉ dùng khi worker chạy ở chỗ khác, nếu không ảnh sẽ nằm "đang xử lý" mãi.
IMAGE_WORKER=

# Không có biến nào cho URL công khai của R2, và đó là chủ đích: backend vẫn trả
# đường dẫn tương đối `/uploads/...` như khi lưu đĩa (xem `R2Provider`). Chỗ
# quyết định `/uploads/*` đi về đâu là `UPLOADS_ORIGIN` bên frontend/dashboard.

# Secret dùng chung với frontend để gọi POST /api/revalidate (xoá cache theo tag).
REVALIDATE_SECRET=

# ===== SePay (nhận tiền chuyển khoản) =====
# Đăng ký ở https://my.sepay.vn — nhận cả tài khoản ngân hàng cá nhân, không
# cần giấy phép kinh doanh để chạy thử.
#
# Tài khoản NHẬN tiền. `SEPAY_BANK_CODE` dùng mã ngắn của VietQR
# (TCB, ACB, VCB, MB, BIDV, VPB…), xem https://qr.sepay.vn.
# `SEPAY_ACCOUNT_NAME` chỉ để hiện trên màn thanh toán cho khách đối chiếu —
# QR không cần nó.
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
#
# Key dùng chung với webhook. Trong SePay: Cấu hình → Webhooks → tạo webhook
# trỏ tới `POST {API_URL}/payments/sepay/webhook`, kiểu xác thực **API Key**.
# SePay sẽ gửi header `Authorization: Apikey <key>`; điền đúng chuỗi đó vào đây.
#
# Bỏ trống → webhook trả 503 và TỪ CHỐI mọi request. Đây là chủ đích: route này
# nâng gói cho thiệp mà không cần đăng nhập, nên chưa cấu hình thì phải đóng,
# không phải mở. Dùng chuỗi ngẫu nhiên đủ dài (`openssl rand -hex 32`).
SEPAY_WEBHOOK_API_KEY=


# ===== Telegram — tin báo cho người vận hành =====
# Báo khi có tài khoản mới và khi đơn đã thanh toán. Bỏ trống thì không gửi gì.
# Bot tạo qua @BotFather; chat id lấy từ https://api.telegram.org/bot<TOKEN>/getUpdates
# sau khi đã nhắn cho bot một tin. Dùng chung bot với backup database (ops/db-backup).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chat phụ nhận **cùng** tin báo (tài khoản mới, đơn đã trả, sự cố email). Bỏ
# trống CHAT_ID thì không gửi. Bỏ trống BOT_TOKEN thì dùng bot chính ở trên —
# nhớ nhắn /start cho bot đó từ chat phụ trước, không thì Telegram từ chối.
# Trả lời lệnh /health... vẫn chỉ về TELEGRAM_CHAT_ID.
TELEGRAM_EXTRA_BOT_TOKEN=
TELEGRAM_EXTRA_CHAT_ID=

# ⚠ Một bot Telegram chỉ có MỘT webhook. Dùng chung TELEGRAM_BOT_TOKEN với
# keemori.com mà điền TELEGRAM_WEBHOOK_SECRET thì stack này gọi setWebhook lúc
# khởi động và cướp webhook của keemori — lệnh /health bên đó ngừng trả lời.
# Hoặc tạo bot riêng cho sukien, hoặc để trống TELEGRAM_WEBHOOK_SECRET ở đây.
# (Chỉ gửi tin báo thì dùng chung bot được, không đụng webhook.)
#
# Lệnh Telegram (/health...). Backend tự gọi setWebhook lúc khởi động khi có đủ
# TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET và PUBLIC_API_URL; bot chỉ trả lời
# đúng TELEGRAM_CHAT_ID. Secret tự sinh: `openssl rand -hex 32` (chỉ chữ, số, _ -).
# Lưu ý: đã có webhook thì link getUpdates ở trên không còn trả tin — muốn lấy
# lại chat id thì gọi deleteWebhook trước.
TELEGRAM_WEBHOOK_SECRET=
# PUBLIC_API_URL (dùng để đăng ký webhook Telegram) khai ở khối "URL công khai"
# phía trên.

# ===== Google Analytics 4 — Data API (đọc báo cáo cho màn Phân tích của CMS) =====
# Chỉ để **đọc**. Bỏ trống cả ba thì backend vẫn chạy bình thường, màn Phân tích
# chỉ hiện lời nhắc chưa kết nối. Khối này không thay bảng `daily_visits` — nó
# trả lời câu khác: khách đến từ đâu, thiết bị gì, xem trang nào.
#
# Cách lấy:
# 1. Google Cloud Console → bật "Google Analytics Data API".
# 2. Tạo Service Account → Keys → Add key → JSON.
# 3. GA → Quản trị → Quản lý quyền truy cập vào tài sản → thêm email service
#    account với quyền "Người xem".
#
# Dãy số ở GA → Quản trị → Chi tiết tài sản. KHÔNG phải mã G-XXXXXXXXXX.
GA_PROPERTY_ID=
# Trường `client_email` trong tệp JSON.
GA_CLIENT_EMAIL=
# Trường `private_key` trong tệp JSON, giữ nguyên cả `\n` và bọc trong nháy kép:
# GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GA_PRIVATE_KEY=
