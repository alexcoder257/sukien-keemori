# URL của backend NestJS
NEXT_PUBLIC_API_URL=http://localhost:3001

# Đặt "true" để hiện nút React Query Devtools khi chạy dev. Mặc định tắt vì nút
# nổi đè lên giao diện.
NEXT_PUBLIC_RQ_DEVTOOLS=

# Nơi `/uploads/*` thật sự nằm (ảnh khách và ảnh biên tập tải lên).
# Để trống = đi về backend, đúng cho dev và cho `STORAGE_DRIVER=local`.
# Khi backend chạy `STORAGE_DRIVER=r2`, trỏ sang custom domain của bucket R2:
#   UPLOADS_ORIGIN=https://cdn.tenmien.com
UPLOADS_ORIGIN=

# Gốc của trang khách (`frontend/`). CMS rewrite `/images/*` sang đây để xem
# trước ảnh mẫu thiệp — ảnh nằm trong `frontend/public/images/`, không phải
# trong `dashboard/public/`. Cũng là gốc của link thiệp đầy đủ trong bảng Thiệp
# (`https://keemori.com/vi/t/<slug>`), nên production phải là tên miền công khai.
# Production: truyền SITE_ORIGIN dưới dạng Docker build arg trước npm run build;
# rewrite được lưu trong routes-manifest.json, đổi biến runtime không cập nhật nó.
SITE_ORIGIN=http://localhost:3000

# ===== Đăng nhập CMS =====
# Tài khoản quản trị nằm ở bảng `admin_users` của backend; route handler
# `app/api/auth/*` gọi backend từ server rồi ghi cookie phiên.
# Gốc công khai của dashboard, dựng URL chuyển hướng sau đăng xuất. Production
# bắt buộc (sau Nginx, origin của request là localhost:3002).
DASHBOARD_URL=http://localhost:3002
